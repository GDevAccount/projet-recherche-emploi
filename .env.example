TAVILY_API_KEY=PUT_YOUR_TAVILY_API_KEY_HERE
OPENAI_API_KEY=PUT_YOUR_OPENAI_API_KEY_HERE
# Mot de passe demandé par l'application quand la connexion Google n'est pas activée
APP_PASSWORD=PUT_YOUR_APP_PASSWORD_HERE
# Signe le cookie de session : obligatoire dès qu'un mot de passe ou la connexion Google est défini.
# À générer avec : python -c "import secrets; print(secrets.token_hex(32))"
AUTH_COOKIE_SECRET=PUT_A_LONG_RANDOM_STRING_HERE

# Connexion Google (facultatif) : laisser ces lignes vides pour garder le mot de passe unique.
GOOGLE_CLIENT_ID=
OWNER_EMAIL=
ALLOWED_EMAILS=
# Administrateurs (facultatif) : ils voient le suivi des recherches et la consommation de chaque compte
ADMIN_EMAILS=
# Alertes (facultatif) : sujet ntfy où partent recherche échouée, panne du serveur et coût anormal.
# Qui connaît ce nom peut lire le sujet : le choisir long et aléatoire. Vide : aucune alerte.
NTFY_TOPIC=
# Budget mensuel de l'instance en dollars, tous comptes réunis (10 par défaut ; 0 : pas de budget)
MONTHLY_BUDGET_USD=
# Budget d'un jour en dollars, tous comptes réunis (0.5 par défaut ; 0 : pas de budget). Atteint, il refuse
# les recherches jusqu'au lendemain, sauf celles du propriétaire
DAILY_BUDGET_USD=
# Essais sans compte que l'instance ouvre par jour : un visiteur essaie l'application sans se connecter,
# avec une seule recherche. Vide ou 0 : aucun essai sans compte
MAX_TRIALS_PER_DAY=
# Adresse de contact affichée sur les pages publiques de confidentialité et de conditions d'utilisation
CONTACT_EMAIL=
# Nom du fichier de validation donné par Google Search Console (google….html), pour prouver que le site vous appartient
GOOGLE_SITE_VERIFICATION_FILE=
# Origines autorisées à appeler l'API depuis un navigateur, séparées par des virgules : seulement si le front est hébergé ailleurs
CORS_ORIGINS=
